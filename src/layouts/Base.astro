---
import '../styles/global.css';
import '../styles/v1-parity.css';
import '../styles/saved-members.css';
import '../styles/shop-card-refinement.css';
import '../styles/header-pinterest-auth.css';
import '../styles/member-login-refresh.css';
import '../styles/member-consents.css';
import '../styles/member-auth-choices.css';
import '../styles/adsense.css';
import '../styles/home-hero-first-screen.css';
import '../styles/mobile-navigation.css';
import '../styles/performance-first-paint.css';
import site from '../data/site.json';
import softnestAdsense from '../data/adsense.json';
import { asAbsolute } from '../lib/escapes';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  kind?: 'article' | 'website';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { title = site.name, description = site.description, image, noindex = false, kind = 'website', schema } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const ogImage = image ? asAbsolute(image, site.url) : `${site.url}/assets/social-preview.svg`;
const path = Astro.url.pathname;
const isHomePage = path === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- softnest-adsense-verification: site ownership only while adsEnabled is false -->
    <meta name="google-adsense-account" content={softnestAdsense.publisherId} />
    {softnestAdsense.adsEnabled && (
      <script is:inline data-publisher-id={softnestAdsense.publisherId}>
        // Preserve AdSense Auto Ads, but avoid competing with the first-screen hero.
        (() => {
          const publisherId = document.currentScript?.getAttribute('data-publisher-id');
          if (!publisherId) return;
          const loadAdsense = () => {
            if (document.querySelector('script[data-softnest-adsense-loader]')) return;
            const script = document.createElement('script');
            script.async = true;
            script.crossOrigin = 'anonymous';
            script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(publisherId)}`;
            script.dataset.softnestAdsenseLoader = '';
            document.head.appendChild(script);
          };
          const onLoaded = () => {
            if ('requestIdleCallback' in window) window.requestIdleCallback(loadAdsense, { timeout: 5000 });
            else window.setTimeout(loadAdsense, 1200);
          };
          if (document.readyState === 'complete') onLoaded();
          else window.addEventListener('load', onLoaded, { once: true });
        })();
      </script>
    )}
    <meta name="p:domain_verify" content="d5194fd5684c6934f80f5ac1da33f85c" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ef" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={kind} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    {isHomePage && (
      <link rel="preload" as="image"
        href="/assets/editorial/living-room-480.webp"
        imagesrcset="/assets/editorial/living-room-480.webp 480w, /assets/editorial/living-room-1080.webp 1080w"
        imagesizes="(max-width: 800px) 100vw, 51vw"
        fetchpriority="high" />
    )}
    <link rel="alternate" type="application/rss+xml" title="The Journal RSS" href="/rss.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    {site.webAnalyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.webAnalyticsToken })}></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="topline">Considered finds, cozy spaces &amp; everyday inspiration <span aria-hidden="true">✳</span></div>
    <header class="site-header" id="site-header">
      <div class="shell nav-wrap">
        <a class="logo" href="/" aria-label="The Soft Nest Edit home"><span class="logo-mark">✳</span><span>THE SOFT NEST <small>EDIT</small></span></a>
        <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          <a class:list={[{'active':path==='/'}, 'nav-link']} href="/">Home</a>
          <a class:list={[{'active':path.startsWith('/shop/') && path !== '/shop/saved/'},'nav-link']} href="/shop/">Shop the Edit</a>
          <a class:list={[{'active':path.startsWith('/journal/') || path.startsWith('/category/')},'nav-link']} href="/journal/">The Journal</a>
          <a class:list={[{'active':path==='/about/'},'nav-link']} href="/about/">Our Story</a>
          <a class="saved-nav" href="/shop/saved/">Saved <span id="saved-count" aria-live="polite">0</span></a>
          <button type="button" class="member-nav" data-member-open hidden>Sign in</button>
        </nav>
        <a class="nav-cta" href="/shop/">Shop decor <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <dialog class="mobile-navigation" id="mobile-navigation" aria-labelledby="mobile-navigation-heading">
      <div class="mobile-navigation-inner">
        <div class="mobile-navigation-top"><span class="mobile-navigation-brand">✳ THE SOFT NEST EDIT</span><button type="button" class="mobile-navigation-close" data-mobile-nav-close aria-label="Close navigation">×</button></div>
        <h2 class="mobile-navigation-heading" id="mobile-navigation-heading">Explore the Edit</h2>
        <div data-mobile-nav-mount></div>
        <div class="mobile-navigation-footer"><a href={site.pinterestUrl} target="_blank" rel="noopener noreferrer">Follow us on Pinterest ↗</a><p>Good design. Real living.</p></div>
      </div>
    </dialog>
    <main id="main"><slot /></main>
    <dialog class="member-dialog" id="member-dialog" aria-labelledby="member-heading" data-auth-redirect={new URL('/shop/saved/', site.url).href}>
      <button type="button" class="member-close" data-member-close aria-label="Close sign-in dialog">×</button>
      <div class="member-brandline">✳ THE SOFT NEST EDIT / MEMBERS</div>
      <div class="member-icon" aria-hidden="true">♡</div>
      <h2 id="member-heading">Welcome to your edit.</h2>
      <div id="member-guest"><p class="member-lede">Save the little details you love. Sign in securely by email to keep your favorites across visits.</p>
        <p class="member-pending-detail" id="member-pending-detail" hidden>Your selected product will be saved as soon as you sign in.</p>
        <div class="member-auth-switch" id="member-auth-switch" role="group" aria-label="Choose account action">
          <button type="button" class="member-auth-tab" data-auth-mode="signin" aria-pressed="true">Sign in</button>
          <button type="button" class="member-auth-tab" data-auth-mode="signup" aria-pressed="false">Create account</button>
        </div>
        <p id="member-auth-mode-help" class="member-auth-help">Already have an account? Enter your email for a secure sign-in link.</p>
        <form id="member-email-form"><label class="member-email-label" for="member-email-input">Email address</label>
          <input class="member-email-input" id="member-email-input" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
          <div class="member-consent-separator" aria-hidden="true"></div>
          <label class="member-consent-choice" for="member-terms-accept">
            <input type="checkbox" id="member-terms-accept" required />
            <span>I agree to the <a href="/terms/" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a> and acknowledge the <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.<small>Required to request a sign-in link. Not consent to marketing.</small></span>
          </label>
          <label class="member-consent-choice member-consent-optin" for="member-newsletter-opt-in">
            <input type="checkbox" id="member-newsletter-opt-in" />
            <span>Send me occasional home styling ideas and updates.<small>Optional newsletter. Off by default; unsubscribe in Account any time.</small></span>
          </label>
          <button class="button" type="submit">Email me a sign-in link</button>
        </form>
        <div class="member-email-sent" id="member-email-sent" hidden>
          <p>We emailed a secure sign-in link to <strong id="member-email-sent-to"></strong>. Open it to sign in automatically. Your selected product will be saved to your account after authentication.</p>
          <p class="member-delivery-help" id="member-delivery-help"><strong>Can't find our email?</strong> Check your Spam or Junk folder, plus Gmail's Promotions tab. Search for “The Soft Nest Edit” or the sender address. Delivery may take a few minutes. If it's still missing, verify the address above and resend the link when available.</p>
          <div class="member-email-sent-actions">
            <button type="button" class="button secondary" id="member-resend-link" disabled>Resend link (60s)</button>
            <button type="button" class="member-change-email" id="member-change-email">Change email</button>
          </div>
        </div>
        <p><small>See our <a href="/privacy/">Privacy Policy</a> for account and saved-list data.</small></p></div>
      <div id="member-signed-in" hidden><p>Signed in as <strong id="member-email"></strong></p>
        <p><a class="text-link" href="/shop/saved/">View your saved finds ↗</a></p>
        <div class="member-consent-account" aria-label="Newsletter settings">
          <h3>Email preferences</h3>
          <label class="member-consent-choice" for="member-newsletter-preference">
            <input type="checkbox" id="member-newsletter-preference" disabled />
            <span>Receive occasional styling emails<small>Separate from essential sign-in messages. Change this any time.</small></span>
          </label>
          <p class="member-consent-status" id="member-consent-status" role="status" aria-live="polite"></p>
        </div>
        <div class="member-consent-account" id="member-legal-review" hidden>
          <h3>Review current policies</h3>
          <p>We do not have a recorded acknowledgement of the current policy versions for this account.</p>
          <label class="member-consent-choice" for="member-legal-review-check">
            <input type="checkbox" id="member-legal-review-check" />
            <span>I agree to the <a href="/terms/" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a> and acknowledge the <a href="/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span>
          </label>
          <button type="button" class="button secondary" id="member-legal-review-save">Record agreement</button>
        </div>
        <button type="button" class="button secondary" data-member-signout>Sign out</button>
      </div>
      <p class="member-message" id="member-message" role="status" aria-live="polite"></p>
    </dialog><span class="member-sr-only" id="member-live" aria-live="polite"></span>
    <footer class="footer">
      <div class="shell footer-layout">
        <div class="footer-brand"><span class="footer-icon" aria-hidden="true">✳</span><h2>The Soft Nest Edit<span>.</span></h2><p>More comfort. More meaning.<br/>A little beauty in the everyday.</p></div>
        <div><h3>Discover</h3><a href="/shop/">Shop the Edit</a><a href="/journal/">The Journal</a><a href="/about/">Our Story</a><a href="/shop/saved/">Your Saved Finds</a></div>
        <div><h3>Good to know</h3><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/privacy/">Privacy Policy</a><a href="/terms/">Terms &amp; Conditions</a><a href="/contact/">Contact</a></div>
        <div class="footer-social"><h3>Follow along</h3><p>Fresh styling ideas and inspiring spaces, saved one pin at a time.</p><a href={site.pinterestUrl} target="_blank" rel="noopener noreferrer">Find us on Pinterest ↗</a></div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} The Soft Nest Edit</span><span>As an Amazon Associate I earn from qualifying purchases.</span></div>
    </footer>
    <script>
      import { initMobileNavigation } from '../scripts/mobile-navigation.js';
      initMobileNavigation();
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => header?.classList.toggle('scrolled', window.scrollY > 20), {passive:true});
      document.querySelectorAll<HTMLElement>('[data-product-search-list]').forEach(container=>{
        const search=document.querySelector<HTMLInputElement>('[data-search]');
        const roomSelect=document.querySelector<HTMLSelectElement>('[data-room-filter]');
        const typeSelect=document.querySelector<HTMLSelectElement>('[data-type-filter]');
        const count=document.querySelector<HTMLElement>('[data-filter-count]');
        const cards=[...container.querySelectorAll<HTMLElement>('[data-searchable]')];
        const typeButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-type-chip]')];
        const params=new URLSearchParams(window.location.search);
        const selectedRoom=params.get('room');
        const selectedType=params.get('type');
        const available=(select:HTMLSelectElement| null,value:string|null)=>!!select&&!!value&&[...select.options].some(opt=>opt.value===value);
        if(available(roomSelect,selectedRoom))roomSelect!.value=selectedRoom!;
        if(available(typeSelect,selectedType))typeSelect!.value=selectedType!;
        let chipType=typeButtons.some(b=>b.dataset.typeChip===selectedType)?selectedType||'all':'all';
        const hasRoom=(card:HTMLElement,room:string)=>room==='all'||(card.dataset.roomSlugs||'').split(' ').includes(room);
        function refreshTypeOptions(){
          if(!typeSelect)return;
          const selected=roomSelect?.value||'all';
          [...typeSelect.options].forEach(opt=>{
            if(opt.value==='all')return;
            const exists=cards.some(card=>hasRoom(card,selected)&&card.dataset.typeSlug===opt.value);
            opt.disabled=!exists;opt.hidden=!exists;
          });
          if(typeSelect.selectedOptions[0]?.disabled)typeSelect.value='all';
        }
        function filter(){
          refreshTypeOptions();
          const q=(search?.value||'').trim().toLowerCase();
          const room=roomSelect?.value||'all';
          const selected=typeButtons.length?chipType:typeSelect?.value||'all';
          let visible=0;
          for(const card of cards){
            const matches=(!q||(card.dataset.searchable||'').includes(q))&&hasRoom(card,room)&&(selected==='all'||card.dataset.typeSlug===selected);
            card.hidden=!matches;if(matches)visible++;
          }
          if(count)count.textContent=`${visible} ${visible===1?'find':'finds'}`;
          const empty=document.querySelector<HTMLElement>('[data-no-matches]');
          if(empty)empty.hidden=visible!==0;
          typeButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.typeChip===chipType)));
        }
        search?.addEventListener('input',filter);
        roomSelect?.addEventListener('change',()=>{refreshTypeOptions();filter();});
        typeSelect?.addEventListener('change',filter);
        typeButtons.forEach(button=>button.addEventListener('click',()=>{
          chipType=button.dataset.typeChip||'all';
          const url=new URL(window.location.href);
          if(chipType==='all')url.searchParams.delete('type');else url.searchParams.set('type',chipType);
          window.history.replaceState(null,'',url);
          filter();
        }));
        filter();
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-affiliate-click]').forEach(link=>{
        link.addEventListener('click',()=>{
          const details={event_category:'affiliate',product_id:link.dataset.affiliateClick||'', outbound:true};
          const w=window as typeof window & {gtag?:(...args:any[])=>void};
          if(typeof w.gtag==='function')w.gtag('event','affiliate_click',details);
        });
      });
    </script>
    <script src="../scripts/activate-members.js"></script>
  </body>
</html>
