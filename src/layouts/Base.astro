---
import '../styles/global.css';
import site from '../data/site.json';
import { asAbsolute } from '../lib/escapes';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  kind?: 'article' | 'website';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { title = site.name, description = site.description, image, noindex = false, kind = 'website', schema } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const ogImage = image ? asAbsolute(image, site.url) : `${site.url}/assets/social-preview.svg`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf9f4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={kind} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/assets/fonts/dm-serif-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="The Journal RSS" href="/rss.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    {site.webAnalyticsToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.webAnalyticsToken })}></script>}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="topline">Considered finds, cozy spaces &amp; everyday inspiration <span aria-hidden="true">✳</span></div>
    <header class="site-header" id="site-header">
      <div class="shell nav-wrap">
        <a class="logo" href="/" aria-label="The Soft Nest Edit home"><span class="logo-mark" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 37 37" fill="none"><path d="M18.5 4c6 6 8 12 0 28C10.5 16 12.5 10 18.5 4Z" stroke="currentColor" stroke-width="1.2"/><path d="M6 15c7 0 13 3 21 17C12 29 8 25 6 15Zm25 0c-7 0-13 3-21 17C25 29 29 25 31 15Z" stroke="currentColor" stroke-width="1.1"/></svg></span><span>THE SOFT NEST <small>EDIT</small></span></a>
        <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          <a class:list={[{'active':path==='/'}, 'nav-link']} aria-current={path === '/' ? 'page' : undefined} href="/">Home</a>
          <a class:list={[{'active':path.startsWith('/shop/') && path !== '/shop/saved/'},'nav-link']} aria-current={path === "/shop/" ? "page" : undefined} href="/shop/">Shop the Edit</a>
          <a class:list={[{'active':path.startsWith('/journal/') || path.startsWith('/category/')},'nav-link']} aria-current={path === "/journal/" ? "page" : undefined} href="/journal/">The Journal</a>
          <a class:list={[{'active':path==='/about/'},'nav-link']} aria-current={path === "/about/" ? "page" : undefined} href="/about/">Our Story</a>
          <a class="saved-nav" aria-current={path === "/shop/saved/" ? "page" : undefined} href="/shop/saved/">Saved <span id="saved-count" aria-live="polite">0</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="shell footer-layout">
        <div class="footer-brand"><span class="footer-icon" aria-hidden="true">✳</span><h2>The Soft Nest Edit<span>.</span></h2><p>More comfort. More meaning.<br/>A little beauty in the everyday.</p></div>
        <div><h3>Discover</h3><a href="/shop/">Shop the Edit</a><a href="/journal/">The Journal</a><a href="/about/">Our Story</a><a href="/shop/saved/">Your Saved Finds</a></div>
        <div><h3>Good to know</h3><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/privacy/">Privacy Policy</a><a href="/contact/">Contact</a><a href="/admin/" rel="nofollow">Editor access</a></div>
        <div class="footer-social"><h3>Follow along</h3><p>Fresh styling ideas and inspiring spaces, saved one pin at a time.</p><a href={site.pinterestUrl} target="_blank" rel="noopener noreferrer">Find us on Pinterest ↗</a></div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} The Soft Nest Edit</span><span>As an Amazon Associate I earn from qualifying purchases.</span></div>
    </footer>
    <script>
      const nav = document.getElementById('site-nav');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const header = document.getElementById('site-header');
      if (nav && toggle && header) {
        header.dataset.menuReady = '';
        function setMenu(open: boolean) {
          nav?.classList.toggle('open', open);
          toggle?.setAttribute('aria-expanded', String(open));
          toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        }
        toggle.addEventListener('click', () => setMenu(!nav.classList.contains('open')));
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && nav.classList.contains('open')) {
            setMenu(false);
            toggle.focus();
          }
        });
        document.addEventListener('pointerdown', event => {
          if (event.target instanceof Node && !nav.contains(event.target) && !toggle.contains(event.target)) setMenu(false);
        });
        nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
      }
      const syncHeader = () => header?.classList.toggle('scrolled', window.scrollY > 16);
      syncHeader();
      window.addEventListener('scroll', syncHeader, { passive: true });

      // Content starts visible. Offscreen elements animate only when they enter the viewport.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('reveal-in');
            observer.unobserve(entry.target);
          }
        }, { threshold: .08 });
        document.querySelectorAll('.room-card, .product-card, .journal-card, .section-head, .intro > div, .prose h2, .manifesto, .shop-room-heading, .footer-layout > div').forEach(element => {
          if (element.getBoundingClientRect().top >= window.innerHeight) observer.observe(element);
        });
      }

      const storageKey='softnest-affiliate-saved-v2';
      const safeSlug=/^[a-z0-9]+(?:-[a-z0-9]+)*$/;
      function saved() : string[] {
        try { const value=JSON.parse(localStorage.getItem(storageKey)||'[]'); return Array.isArray(value) ? [...new Set(value.filter(v=>typeof v==='string' && safeSlug.test(v)))].slice(0,100) as string[] : []; } catch {return [];}
      }
      function updateSaves(){
        const ids=new Set(saved());
        const count=document.getElementById('saved-count');if(count)count.textContent=String(ids.size);
        document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(button=>{
          const active=ids.has(button.dataset.save||'');
          button.setAttribute('aria-pressed',String(active));
          button.textContent=active?'♥ Saved':'♡ Save';
        });
        document.dispatchEvent(new CustomEvent('softnest:saved'));
      }
      document.addEventListener('click',event=>{
        const button=(event.target as Element)?.closest<HTMLButtonElement>('[data-save]');
        if(!button)return;
        const id=button.dataset.save||'';if(!safeSlug.test(id))return;
        const ids=saved();const i=ids.indexOf(id);if(i>=0)ids.splice(i,1);else ids.push(id);
        try{localStorage.setItem(storageKey,JSON.stringify(ids));}catch{}
        updateSaves();
      });
      document.querySelectorAll<HTMLElement>('[data-product-search-list]').forEach(container=>{
        const search=document.querySelector<HTMLInputElement>('[data-search]');
        const roomSelect=document.querySelector<HTMLSelectElement>('[data-room-filter]');
        const typeSelect=document.querySelector<HTMLSelectElement>('[data-type-filter]');
        const count=document.querySelector<HTMLElement>('[data-filter-count]');
        const cards=[...container.querySelectorAll<HTMLElement>('[data-searchable]')];
        const typeButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-type-chip]')];
        const params=new URLSearchParams(window.location.search);
        const selectedRoom=params.get('room');
        const selectedType=params.get('type');
        const available=(select:HTMLSelectElement| null,value:string|null)=>!!select&&!!value&&[...select.options].some(opt=>opt.value===value);
        if(available(roomSelect,selectedRoom))roomSelect!.value=selectedRoom!;
        if(available(typeSelect,selectedType))typeSelect!.value=selectedType!;
        let chipType=typeButtons.some(b=>b.dataset.typeChip===selectedType)?selectedType||'all':'all';
        const hasRoom=(card:HTMLElement,room:string)=>room==='all'||(card.dataset.roomSlugs||'').split(' ').includes(room);
        function refreshTypeOptions(){
          if(!typeSelect)return;
          const selected=roomSelect?.value||'all';
          [...typeSelect.options].forEach(opt=>{
            if(opt.value==='all')return;
            const exists=cards.some(card=>hasRoom(card,selected)&&card.dataset.typeSlug===opt.value);
            opt.disabled=!exists;opt.hidden=!exists;
          });
          if(typeSelect.selectedOptions[0]?.disabled)typeSelect.value='all';
        }
        function filter(){
          refreshTypeOptions();
          const q=(search?.value||'').trim().toLowerCase();
          const room=roomSelect?.value||'all';
          const selected=typeButtons.length?chipType:typeSelect?.value||'all';
          let visible=0;
          for(const card of cards){
            const matches=(!q||(card.dataset.searchable||'').includes(q))&&hasRoom(card,room)&&(selected==='all'||card.dataset.typeSlug===selected);
            card.hidden=!matches;if(matches)visible++;
          }
          if(count)count.textContent=`${visible} ${visible===1?'find':'finds'}`;
          const empty=document.querySelector<HTMLElement>('[data-no-matches]');
          if(empty)empty.hidden=visible!==0;
          typeButtons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.typeChip===chipType)));
        }
        search?.addEventListener('input',filter);
        roomSelect?.addEventListener('change',()=>{refreshTypeOptions();filter();});
        typeSelect?.addEventListener('change',filter);
        typeButtons.forEach(button=>button.addEventListener('click',()=>{
          chipType=button.dataset.typeChip||'all';
          const url=new URL(window.location.href);
          if(chipType==='all')url.searchParams.delete('type');else url.searchParams.set('type',chipType);
          window.history.replaceState(null,'',url);
          filter();
        }));
        filter();
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-affiliate-click]').forEach(link=>{
        link.addEventListener('click',()=>{
          const details={event_category:'affiliate',product_id:link.dataset.affiliateClick||'', outbound:true};
          const w=window as typeof window & {gtag?:(...args:any[])=>void};
          if(typeof w.gtag==='function')w.gtag('event','affiliate_click',details);
        });
      });
      updateSaves();
      window.addEventListener('storage', event => {
        if (event.key === storageKey || event.key === null) updateSaves();
      });
    </script>
  </body>
</html>
