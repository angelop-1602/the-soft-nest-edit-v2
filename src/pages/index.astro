---
import AffiliateNote from '../components/AffiliateNote.astro';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialImage from '../components/EditorialImage.astro';
import RoomGrid from '../components/RoomGrid.astro';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import JournalCard from '../components/JournalCard.astro';
import { getPublishedProducts, getPublishedPosts } from '../lib/catalog';
import site from '../data/site.json';
const products=await getPublishedProducts();
const posts=await getPublishedPosts();
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','name':site.name,'url':site.url,'sameAs':[site.pinterestUrl]},{'@type':'WebSite','name':site.name,'url':site.url}]};
---
<Base title="Cozy Home Styling Ideas & Curated Finds | The Soft Nest Edit" description={site.description} schema={schema}>
  <section class="hero">
    <div class="hero-panel"><div class="hero-panel-inner"><span class="kicker">THE SOFT NEST EDIT</span><h1>Make room for<br/>a home <em>you love.</em></h1><p>Beautiful spaces aren't built overnight. Find thoughtful ideas, warm textures, and carefully curated details that make a house feel like yours.</p><div class="hero-actions"><a class="button" href="/shop/">Explore the Edit ↗</a><a class="text-link" href="/journal/">Read our Journal ↗</a></div></div></div>
    <div class="hero-media"><EditorialImage photo="living-room" alt="Cream sofa, woven chair and a pale wood coffee table in a sunlit living room" sizes="(max-width: 700px) 100vw, 52vw" priority /><a class="hero-stamp" href="/shop/room/living-room/">Explore the living room ↗</a></div>
  </section>
  <section class="intro shell"><div><span class="kicker">A MORE INTENTIONAL WAY TO DECORATE</span><h2>Less about buying more.<br/><em>More about loving where you live.</em></h2></div><div><p>We're here for approachable styling inspiration and genuinely useful finds, chosen to suit real spaces and real life.</p><a class="text-link" href="/about/">Read our story ↗</a></div></section>
  <section class="section section-tinted"><div class="shell"><div class="section-head"><div><span class="eyebrow">SHOP BY ROOM</span><h2 class="section-title">Every corner, <em>considered.</em></h2></div><p>Find pieces that fit your space. Choose a room, then narrow the collection by item type.</p></div><RoomGrid {products} /></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">SHOP THE EDIT</span><h2 class="section-title">A little more <em>lovely.</em></h2></div><a href="/shop/" class="text-link">Discover the collection ↗</a></div>{products.length > 0 && <AffiliateNote />}
    {products.length ? <div class:list={["product-grid", { "featured-single": products.length === 1 }]}>{products.slice(0,3).map(p=><ProductCard product={p}/>)}</div> : <div class="empty-state"><div class="symbol" aria-hidden="true">✳</div><h3>Thoughtful finds are on their way.</h3><p>We're reviewing our first selections. Explore the Journal while we prepare our curated Amazon recommendations.</p><a class="button secondary" href="/journal/">Explore styling ideas ↗</a></div>}
  </div></section>
  <section class="section section-tinted"><div class="shell"><div class="section-head"><div><span class="eyebrow">THE JOURNAL</span><h2 class="section-title">Stories for <em>living well.</em></h2></div><a href="/journal/" class="text-link">View all stories ↗</a></div><div class="journal-grid">{posts.slice(0,3).map(p=><JournalCard post={p}/>)}</div></div></section>
  <EditorialHero eyebrow="OUR PHILOSOPHY" description="Thoughtful spaces come together through the little things you reach for every day." photo="about" heading={2}>
    Make it feel <em>like home.</em>
    <a slot="actions" href="/about/" class="button cream">Get to know us ↗</a>
  </EditorialHero>
</Base>
