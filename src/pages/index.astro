---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import JournalCard from '../components/JournalCard.astro';
import { getPublishedProducts, getPublishedPosts } from '../lib/catalog';
import { categories } from '../data/categories';
import site from '../data/site.json';
const products=await getPublishedProducts();
const posts=await getPublishedPosts();
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','name':site.name,'url':site.url,'sameAs':[site.pinterestUrl]},{'@type':'WebSite','name':site.name,'url':site.url}]};
---
<Base title="Cozy Home Styling Ideas & Curated Finds | The Soft Nest Edit" description={site.description} schema={schema}>
  <section class="hero">
    <div class="hero-panel"><div class="hero-panel-inner"><span class="kicker">THE SOFT NEST EDIT / THE EVERYDAY EDIT</span><h1>Make room<br/>for a home<br/><em>you love.</em></h1><p>Beautiful spaces aren't built overnight. Find thoughtful ideas, warm textures, and carefully curated details that make a house feel like yours.</p><div class="hero-actions"><a class="button" href="/shop/">Explore the Edit ↗</a><a class="text-link" href="/journal/">Read our Journal ↗</a></div></div></div>
    <div class="hero-media"><img src="https://images.unsplash.com/photo-1722942631531-5b09fed44978?auto=format&fit=crop&w=1500&q=84" alt="Warm neutral living room with a comfortable sofa and soft natural light" fetchpriority="high" width="1400" height="1250"/><span class="hero-stamp">GOOD LIVING BEGINS AT HOME.</span></div>
  </section>
  <section class="intro"><span class="kicker">A MORE INTENTIONAL WAY TO DECORATE</span><h2>Less about buying more.<br/><em>More about loving where you live.</em></h2><p>We're here for approachable styling inspiration and genuinely useful finds, chosen to suit real spaces and real life.</p></section>
  <section class="section shell"><div class="section-head"><div><span class="eyebrow">ROOM BY ROOM</span><h2 class="section-title">Every corner, <em>considered.</em></h2></div><p>From restful bedrooms to the smallest apartments, start with the space that matters to you.</p></div><div class="category-grid">{categories.map(c=><a class="category-card" href={`/category/${c.slug}/`}><div class="category-image"><img src={c.image} alt={`${c.name} interior inspiration`} loading="lazy" width="440" height="540"/></div><h3>{c.name} ↗</h3><p>{c.subtitle}</p></a>)}</div></section>
  <section class="section" style="background:#f7f6f0"><div class="shell"><div class="section-head"><div><span class="eyebrow">SHOP THE EDIT</span><h2 class="section-title">A little more <em>lovely.</em></h2></div><a href="/shop/" class="text-link">Discover the collection ↗</a></div><div class="affiliate-note"><strong>Affiliate note:</strong> As an Amazon Associate I earn from qualifying purchases. Product prices and availability are checked on Amazon.</div>
    {products.length ? <div class="product-grid">{products.slice(0,3).map(p=><ProductCard product={p}/>)}</div> : <div class="empty-state"><div class="symbol" aria-hidden="true">✳</div><h3>Thoughtful finds are on their way.</h3><p>We're reviewing our first selections. Explore the Journal while we prepare our curated Amazon recommendations.</p><a class="button secondary" href="/journal/">Explore styling ideas ↗</a></div>}
  </div></section>
  <section class="section shell"><div class="section-head"><div><span class="eyebrow">THE JOURNAL</span><h2 class="section-title">Stories for <em>living well.</em></h2></div><a href="/journal/" class="text-link">View all stories ↗</a></div><div class="journal-grid">{posts.slice(0,3).map(p=><JournalCard post={p}/>)}</div></section>
  <section class="editorial"><div class="editorial-photo"><img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1200&q=85" alt="Natural textures and warm home decor in a quiet living space" loading="lazy" width="1000" height="900"/></div><div class="editorial-copy"><span class="eyebrow">OUR PHILOSOPHY</span><h2>Make it feel<br/><em>like home.</em></h2><p>Thoughtful spaces aren't about perfection. They're about the little things you reach for every day—the lighting, the texture, the comfort.</p><a href="/about/" class="text-link">Get to know us ↗</a></div></section>
</Base>
