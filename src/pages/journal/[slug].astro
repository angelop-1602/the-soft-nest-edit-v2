---
import Base from '../../layouts/Base.astro';
import JournalCard from '../../components/JournalCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getPublishedPosts,getPublishedProducts,dateISO,dateDisplay } from '../../lib/catalog';
import { categorySlug } from '../../data/categories';
import { render } from 'astro:content';
import site from '../../data/site.json';
export async function getStaticPaths(){
 const posts=await getPublishedPosts();
 return posts.map(post=>({params:{slug:post.id},props:{post,other:posts.filter(p=>p.id!==post.id).slice(0,3)}}));
}
const {post,other}=Astro.props;
const {Content}=await render(post);
const p=post.data;
const products=(await getPublishedProducts()).filter(product=>p.related_products.some(ref=>ref.replace(/\\/g,'/').split('/').pop()?.replace(/\.md$/,'')===product.id));
const url=`${site.url}/journal/${post.id}/`;
const articleSchema={'@context':'https://schema.org','@type':'BlogPosting','headline':p.title,'description':p.description,'datePublished':dateISO(p.date),...(p.updated?{'dateModified':dateISO(p.updated)}:{}),'mainEntityOfPage':url,'image':p.image?[p.image.startsWith('https://')?p.image:new URL(p.image,site.url).href]:[], 'author':{'@type':'Organization','name':site.name},'publisher':{'@type':'Organization','name':site.name,'url':site.url}};
const pinUrl=`https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(p.title)}${p.image?`&media=${encodeURIComponent(p.image.startsWith('https://')?p.image:new URL(p.image,site.url).href)}`:''}`;
---
<Base title={`${p.title} | The Soft Nest Edit`} description={p.description} image={p.image} kind="article" schema={articleSchema}>
  <div class="shell"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/journal/">Journal</a> / <a href={`/category/${categorySlug(p.category)}/`}>{p.category}</a></nav></div>
  <header class="article-header shell reading"><span class="eyebrow">{p.category} <span class="dot">·</span> {dateDisplay(p.date)}</span><h1>{p.title}</h1><p class="article-desc">{p.description}</p>{p.updated && <span class="count">Updated {dateDisplay(p.updated)}</span>}</header>
  {p.image && <img class="article-image" src={p.image} alt={p.image_alt||p.title} width="1300" height="750" fetchpriority="high"/>}
  <article class="reading"><div class="prose"><Content /></div>
    {products.length>0 && <><hr class="thin-divider"/><h2 class="section-title">Shop the <em>details.</em></h2><p class="affiliate-note"><strong>Affiliate disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. Product prices and stock are set by Amazon.</p><div class="product-grid" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr))">{products.map(pr=><ProductCard product={pr}/>)}</div></>}
    <div class="article-footer"><a class="text-link" href="/journal/">← All journal stories</a><a class="text-link" href={pinUrl} target="_blank" rel="noopener noreferrer">Save this idea to Pinterest ↗</a></div>
  </article>
  {other.length>0 && <section class="section" style="background:#f7f6f0"><div class="shell"><div class="section-head"><h2 class="section-title">Keep <em>exploring.</em></h2></div><div class="journal-grid">{other.map(otherPost=><JournalCard post={otherPost}/>)}</div></div></section>}
</Base>
