---
import EditorialImage from '../../components/EditorialImage.astro';
import { localJournalPhoto } from '../../data/editorial';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import JournalCard from '../../components/JournalCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getPublishedPosts,getPublishedProducts,dateISO,dateDisplay } from '../../lib/catalog';
import { categorySlug } from '../../data/categories';
import { render } from 'astro:content';
import site from '../../data/site.json';
export async function getStaticPaths(){
 const posts=await getPublishedPosts();
 return posts.map(post=>({params:{slug:post.id},props:{post,other:posts.filter(p=>p.id!==post.id).slice(0,3)}}));
}
const {post,other}=Astro.props;
const {Content}=await render(post);
const p=post.data;
const photo = localJournalPhoto(p.image);
const products=(await getPublishedProducts()).filter(product=>p.related_products.some(ref=>ref.replace(/\\/g,'/').split('/').pop()?.replace(/\.md$/,'')===product.id));
const url=`${site.url}/journal/${post.id}/`;
const articleSchema={'@context':'https://schema.org','@type':'BlogPosting','headline':p.title,'description':p.description,'datePublished':dateISO(p.date),...(p.updated?{'dateModified':dateISO(p.updated)}:{}),'mainEntityOfPage':url,'image':p.image?[p.image.startsWith('https://')?p.image:new URL(p.image,site.url).href]:[], 'author':{'@type':'Organization','name':site.name},'publisher':{'@type':'Organization','name':site.name,'url':site.url}};
const pinUrl=`https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(p.title)}${p.image?`&media=${encodeURIComponent(p.image.startsWith('https://')?p.image:new URL(p.image,site.url).href)}`:''}`;
---
<Base title={`${p.title} | The Soft Nest Edit`} description={p.description} image={p.image} kind="article" schema={articleSchema}>
  <Breadcrumbs links={[{ label: "Journal", href: "/journal/" }, { label: p.category, href: `/category/${categorySlug(p.category)}/` }]} current={p.title} />
  <header class="article-header shell"><span class="eyebrow">{p.category} <span class="dot">·</span> {dateDisplay(p.date)}</span><h1>{p.title}</h1><p class="article-desc">{p.description}</p>{p.updated && <span class="count">Updated {dateDisplay(p.updated)}</span>}</header>
  {p.image && <div class="article-photo">{photo ? <EditorialImage {photo} class="article-image" alt={p.image_alt || p.title} sizes="(max-width: 1150px) 92vw, 1050px" priority /> : <img class="article-image" src={p.image} alt={p.image_alt||p.title} width="1300" height="750" fetchpriority="high" decoding="async"/>}</div>}
  <article class="shell reading article-reading">
    <aside class="article-aside" aria-label="About this story">
      <span class="eyebrow">THE SOFT NEST EDIT / JOURNAL</span>
      <p>Little ideas for a home you love.</p>
      <div class:list={['pinterest-share-links', {single: !p.pinterest_pin_url}]}>
        <a href={pinUrl} target="_blank" rel="noopener noreferrer">Save on Pinterest ↗</a>
        {p.pinterest_pin_url && <a href={p.pinterest_pin_url} target="_blank" rel="noopener noreferrer">View our Pinterest Pin ↗</a>}
      </div>
    </aside>
    <div class="article-reading-content"><div class="prose"><Content /></div>
    {products.length>0 && <><hr class="thin-divider"/><h2 class="section-title">Shop the <em>details.</em></h2><div class="product-grid">{products.map(pr=><ProductCard product={pr}/>)}</div></>}
    <div class="article-footer"><a class="text-link" href="/journal/">← All journal stories</a><a class="text-link" href={pinUrl} target="_blank" rel="noopener noreferrer">Save this idea to Pinterest ↗</a>{p.pinterest_pin_url && <a class="text-link article-footer-pin" href={p.pinterest_pin_url} target="_blank" rel="noopener noreferrer">View our Pinterest Pin ↗</a>}</div>
    </div>
  </article>
  {other.length>0 && <section class="section section-tinted"><div class="shell"><div class="section-head"><h2 class="section-title">Keep <em>exploring.</em></h2></div><div class="journal-grid">{other.map(otherPost=><JournalCard post={otherPost}/>)}</div></div></section>}
</Base>
