---
import EditorialHero from '../../components/EditorialHero.astro';
import Base from '../../layouts/Base.astro';
import { getPublishedProducts } from '../../lib/catalog';
const products=(await getPublishedProducts()).map(p=>({id:p.id,title:p.data.title,summary:p.data.summary,category:p.data.category,url:`/shop/${p.id}/`,image:p.data.image&&p.data.image_rights_confirmed?p.data.image:null}));
const safeJson=JSON.stringify(products).replace(/</g,'\\u003c');
---
<Base title="Your Saved Finds | The Soft Nest Edit" description="Your personally saved home decor recommendations." noindex>
  <EditorialHero eyebrow="YOUR LITTLE COLLECTION" description="Keep favorite recommendations close while you plan your next styling update. Sign in to keep your favorite finds across devices, or save them in this browser." photo="saved">Saved <em>finds.</em></EditorialHero>
  <section class="section shell section-compact"><noscript><p>Enable JavaScript to see the finds saved in this browser.</p><style>#saved-message{display:none}</style></noscript><p class="count" role="status" id="saved-message">Loading your saved finds...</p><div class="member-saved-gate" id="saved-login-gate" hidden>
    <h2>Sign in to see your favorites</h2>
    <p>Use your email to access the products you've saved on any device.</p><button class="button" data-member-open type="button">Sign in with email</button>
  </div>
  <p id="saved-local-notice" class="count" hidden>These finds are saved only in this browser. Account syncing will be available when the member service is configured.</p>
  <div class="member-saved-gate" id="saved-import-gate" hidden><h2>Saved things on this device?</h2>
    <p>Import your older browser-only saved products into your account. This moves your saved identifiers into your account's private collection.</p>
    <button class="button secondary" data-import-saved type="button">Import saved finds</button>
  </div><div class="product-grid" id="saved-grid"></div><div class="empty-state" id="saved-empty" hidden><div class="symbol" aria-hidden="true">✳</div><h3>Nothing saved yet.</h3><p>Save your favorite products from the Shop to find them again here.</p><a class="button secondary" href="/shop/">Browse the edit ↗</a></div></section>
  <script id="saved-data" type="application/json" set:html={safeJson} />
<script src="../../scripts/saved-page.js"></script>
</Base>
