---
import AffiliateNote from '../../components/AffiliateNote.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Base from '../../layouts/Base.astro';
import { getPublishedProducts,getPublishedPosts } from '../../lib/catalog';
import { productSlug } from '../../lib/publication-rules.js';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { roomsForProduct, roomSlugsForProduct } from '../../lib/shop-taxonomy';
export async function getStaticPaths() {
  const products=await getPublishedProducts();
  return products.map(product=>({params:{slug:product.id},props:{product,related:products.filter(p=>p.id!==product.id && (roomsForProduct(p.data).some(room=>roomsForProduct(product.data).includes(room)) || (p.data.product_type && p.data.product_type===product.data.product_type))).slice(0,3)}}));
}
const {product,related}=Astro.props;
const p=product.data;
const guides=(await getPublishedPosts()).filter(post=>post.data.related_products.some(ref=>productSlug(ref)===product.id)).slice(0,3);
// A prior import stored internal approval reminders in a shopper-facing field.
// Never render photo-rights, tracking, or editorial approval instructions to customers.
const publicConsiderations = p.considerations && !/(?:photo rights|before approving|before publishing|SiteStripe|special link|affiliate tracking|editor note)/i.test(p.considerations)
  ? p.considerations : undefined;
const hasImage=p.image && p.image_rights_confirmed;
const firstRoom=roomsForProduct(p)[0];
const firstRoomSlug=roomSlugsForProduct(p)[0];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
{'@type':'ListItem','position':1,'name':'Home','item':site.url+'/'},
{'@type':'ListItem','position':2,'name':'Shop','item':site.url+'/shop/'},
...(firstRoom&&firstRoomSlug?[{'@type':'ListItem','position':3,'name':firstRoom,'item':site.url+`/shop/room/${firstRoomSlug}/`}]:[]),
{'@type':'ListItem','position':firstRoom?4:3,'name':p.title,'item':site.url+`/shop/${product.id}/`} ]};
---
<Base title={`${p.title} | Curated Home Decor | The Soft Nest Edit`} description={p.summary} image={hasImage?p.image:undefined} schema={breadcrumb}>
  <Breadcrumbs links={[{ label: "Shop", href: "/shop/" }, ...(firstRoom && firstRoomSlug ? [{ label: firstRoom, href: `/shop/room/${firstRoomSlug}/` }] : [])]} current={p.title} />
  <section class="shell detail"><div class="detail-image">{hasImage ? <img src={p.image} alt={p.image_alt||p.title} width="750" height="900" fetchpriority="high" decoding="async"/> : <div class="product-placeholder"><span aria-hidden="true">✳</span><small>THE SOFT NEST EDIT</small></div>}</div>
    <div class="detail-content"><span class="eyebrow">{firstRoom || p.category} / {p.product_type || 'Editorial pick'}</span><h1>{p.title}</h1><p class="lead">{p.summary}</p><div class="detail-points">
      {p.best_for && <><h2>Best suited for</h2><p>{p.best_for}</p></>}
      {p.highlights.length>0 && <><h2>What caught our eye</h2><ul>{p.highlights.map(h=><li>{h}</li>)}</ul></>}
      {publicConsiderations && <><h2>Good to know</h2><p>{publicConsiderations}</p></>}
    </div><div class="detail-cta"><a aria-describedby="purchase-disclosure" class="button" href={p.affiliate_url} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-click={product.id}>View product on Amazon ↗</a><button class="button secondary" type="button" aria-label={`Save ${p.title}`} data-save={product.id} aria-pressed="false">♡ Save</button></div>
    <AffiliateNote compact id="purchase-disclosure" />
    {guides.length>0 && <section class="note-panel" aria-label="Related styling guides"><h2>See how to style it</h2><ul>{guides.map(guide=><li><a class="text-link" href={`/journal/${guide.id}/`}>{guide.data.title}</a></li>)}</ul></section>}
    </div>
  </section>
  {related.length>0 && <section class="related-products"><div class="shell"><div class="section-head"><h2 class="section-title">A little more <em>inspiration.</em></h2><a class="text-link" href="/shop/">View all finds ↗</a></div><div class="product-grid">{related.map(r=><ProductCard product={r}/>)}</div></div></section>}
</Base>
