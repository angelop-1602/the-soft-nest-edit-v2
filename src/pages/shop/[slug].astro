---
import Base from '../../layouts/Base.astro';
import { getPublishedProducts, dateDisplay } from '../../lib/catalog';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { roomsForProduct, roomSlugsForProduct } from '../../lib/shop-taxonomy';
export async function getStaticPaths() {
  const products=await getPublishedProducts();
  return products.map(product=>({params:{slug:product.id},props:{product,related:products.filter(p=>p.id!==product.id && (roomsForProduct(p.data).some(room=>roomsForProduct(product.data).includes(room)) || (p.data.product_type && p.data.product_type===product.data.product_type))).slice(0,3)}}));
}
const {product,related}=Astro.props;
const p=product.data;
const hasImage=p.image && p.image_rights_confirmed;
const firstRoom=roomsForProduct(p)[0];
const firstRoomSlug=roomSlugsForProduct(p)[0];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[
{'@type':'ListItem','position':1,'name':'Home','item':site.url+'/'},
{'@type':'ListItem','position':2,'name':'Shop','item':site.url+'/shop/'},
...(firstRoom&&firstRoomSlug?[{'@type':'ListItem','position':3,'name':firstRoom,'item':site.url+`/shop/room/${firstRoomSlug}/`}]:[]),
{'@type':'ListItem','position':firstRoom?4:3,'name':p.title,'item':site.url+`/shop/${product.id}/`} ]};
---
<Base title={`${p.title} | Curated Home Decor | The Soft Nest Edit`} description={p.summary} image={hasImage?p.image:undefined} schema={breadcrumb}>
  <nav class="shell breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/shop/">Shop the Edit</a> / {firstRoom&&firstRoomSlug&&<><a href={`/shop/room/${firstRoomSlug}/`}>{firstRoom}</a> / </>}{p.title}</nav>
  <section class="shell detail"><div class="detail-image">{hasImage ? <img src={p.image} alt={p.image_alt||p.title} width="750" height="900"/> : <div class="product-placeholder"><span aria-hidden="true">✳</span><small>THE SOFT NEST EDIT</small></div>}</div>
    <div class="detail-content"><span class="eyebrow">{firstRoom || p.category} / {p.product_type || 'Editorial pick'}</span><h1>{p.title}</h1><p class="lead">{p.summary}</p><div class="detail-points">
      {p.best_for && <><h2>Best suited for</h2><p>{p.best_for}</p></>}
      {p.highlights.length>0 && <><h2>What caught our eye</h2><ul>{p.highlights.map(h=><li>{h}</li>)}</ul></>}
      {p.considerations && <><h2>Before you buy</h2><p>{p.considerations}</p></>}
    </div><div class="detail-cta"><a class="button" href={p.affiliate_url} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-click={product.id}>View product on Amazon ↗</a><button class="button secondary" type="button" data-save={product.id} aria-pressed="false">♡ Save</button></div>
    <p class="detail-disclosure">As an Amazon Associate I earn from qualifying purchases. Prices, variants, returns and availability are determined by Amazon. {p.reviewed_at && `Editorial information reviewed ${dateDisplay(p.reviewed_at)}.`}</p>
    </div>
  </section>
  {related.length>0 && <section class="related-products"><div class="shell"><div class="section-head"><h2 class="section-title">A little more <em>inspiration.</em></h2><a class="text-link" href="/shop/">View all finds ↗</a></div><div class="product-grid">{related.map(r=><ProductCard product={r}/>)}</div></div></section>}
</Base>
