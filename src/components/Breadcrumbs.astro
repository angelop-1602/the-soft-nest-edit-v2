---
interface Props {
  links: { label: string; href: string }[];
  current?: string;
}
const { links, current } = Astro.props;
---
<nav class="shell breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {links.map(({label, href}) => <li><a {href}>{label}</a></li>)}
    {current && <li aria-current="page">{current}</li>}
  </ol>
</nav>
