---
/** Deliberately inactive until site approval and real ad unit IDs are supplied. */
import adsense from '../data/adsense.json';
interface Props { placement: 'home' | 'journal' }
const { placement } = Astro.props;
const slot = adsense.slots[placement];
const active = adsense.adsEnabled
  && /^ca-pub-\d{16}$/.test(adsense.publisherId)
  && /^\d{8,20}$/.test(slot);
---
{active && (
  <section class="softnest-ad-slot" aria-label="Advertisement">
    <span class="softnest-ad-label">Advertisement</span>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={adsense.publisherId}
         data-ad-slot={slot}
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </section>
)}
